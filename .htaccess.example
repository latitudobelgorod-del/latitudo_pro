Options -Indexes
ErrorDocument 404 /404.php

# Secrets / dev-only files — never serve over HTTP, never deploy to prod
<FilesMatch "(^figma\.token$|\.token$|\.env$)">
  Require all denied
</FilesMatch>

<IfModule mod_php5.c>
  php_flag allow_call_time_pass_reference 1
  php_flag session.use_trans_sid off

  #php_value display_errors 1

  #php_value mbstring.internal_encoding UTF-8
</IfModule>

<IfModule mod_rewrite.c>
  Options +FollowSymLinks
  RewriteEngine On

  # --- Страницы без .php в адресе -------------------------------------------
  # /policy.php → /policy, /terms.php → /terms, /search/map.php → /search/map.
  # Расширение — деталь реализации, в адресе страницы ему делать нечего.
  #
  # Служебные ветки исключены целиком: /bitrix/ — ядро и админка (там сотни
  # .php-адресов, любой редирект их ломает), /local/ и /include/ — код и
  # включаемые области (отдельными страницами не открываются),
  # /upload/ — пользовательские файлы.

  # 1) Внешний запрос с .php → 301 на чистый адрес.
  #    THE_REQUEST — исходная строка запроса, она НЕ меняется при внутренней
  #    подмене из правила (2). Без неё правила зациклятся: (2) перепишет
  #    /policy на /policy.php, Apache прогонит набор заново, и (1) снова
  #    отправит редирект на /policy.
  #    Только GET: у POST браузер при редиректе теряет тело формы.
  #    index.php не трогаем — его канонический адрес «/», он закрыт в robots.txt,
  #    и на него шлёт формы сам Битрикс. 404.php не трогаем — он отдаётся
  #    через ErrorDocument, и редирект превратил бы «страница не найдена»
  #    в обычную страницу с кодом 200.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+[a-z0-9/_-]+\.php[\s?]" [NC]
  RewriteCond %{REQUEST_URI} !^/(bitrix|local|include|upload)/
  RewriteCond %{REQUEST_URI} !(^|/)(index|404)\.php$
  RewriteRule ^([a-z0-9/_-]+)\.php$ /$1 [R=301,L]

  # 2) Чистый адрес → отдаём соответствующий .php, если такой файл есть.
  #    Подмена внутренняя, адрес в строке браузера не меняется.
  #    Завершающий слеш намеренно не принимаем: иначе одна и та же страница
  #    открывалась бы и по /policy, и по /policy/ — для поиска это дубль.
  #    Разделы каталога (/zabory/ и прочие) сюда не попадают: одноимённых
  #    .php-файлов в корне нет, они уходят дальше — в диспетчер лендингов.
  RewriteCond %{REQUEST_URI} !^/(bitrix|local|include|upload)/
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([a-z0-9/_-]+)$ /$1.php [L]

  # --- Всё несуществующее — маршрутизатору Битрикса --------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
  RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
  RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresByType image/jpeg "access plus 3 day"
  ExpiresByType image/gif "access plus 3 day"
</IfModule>
