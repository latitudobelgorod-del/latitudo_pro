# ============================================================
#  .gitignore для сайта Latitudo (1С-Битрикс)
#  Правило простое: храним ТОЛЬКО свой код. Движок, база и
#  секреты в Git не попадают.
# ============================================================

# --- Движок Битрикса (как node_modules — чужой код, 1.3 ГБ) ---
/bitrix/

# --- Секреты: пароли, токены. В GitHub — НИКОГДА ---
figma.token
*.token
*.env
.env*
*.webhook
b24.webhook
/bitrix/.settings.php
/bitrix/.settings_extra.php
/bitrix/php_interface/dbconn.php

# --- Загруженные медиа (переносим отдельно, через сервер) ---
/upload/

# --- Очередь офлайн-конверсий Метрики (данные рантайма, у каждой среды свои) ---
# Логи ловит правило *.log ниже; очередь и батчи — здесь.
/local/logs/*.jsonl
/local/logs/*.batch
/local/logs/*.csv

# --- Кэш и служебные папки локальной среды ---
/.figma-cache/
/.osp/
/bitrix/cache/
/bitrix/managed_cache/
/bitrix/stack_cache/
/upload/resize_cache/

# --- Временные файлы выгрузок/дампов БД ---
*.sql
*.sql.gz
*.tar.gz
*.zip
/_dump/
# Сюда складываются архивы, снятые с прода при развёртывании локалки
# (движок, upload, дамп базы). Нужны только на время переноса.
/_transfer/
/tmp/

# --- Мусор операционной системы и редакторов ---
Thumbs.db
desktop.ini
.DS_Store
*.log
*~
.idea/
.vscode/
# Локальные разрешения Claude Code — на каждой машине свои
.claude/settings.local.json

# КОРНЕВОЙ .htaccess зависит от окружения (Apache локально vs хостинг) — не версионируем.
# Эталон лежит в .htaccess.example.
# Ведущий слэш обязателен: без него правило пряталo и вложенные .htaccess (tools/.htaccess),
# а они от окружения не зависят и обязаны уезжать на прод вместе с кодом.
/.htaccess
/.htaccess.restore
/.htaccess.beget

# Скриншоты проверки рендера (Playwright)
/latitudo-*.jpeg
/page-*.png

# Внутренние планы/заметки — не версионируем и не отдаём на прод
docs/
.playwright-mcp/

# Playwright verification screenshots
*-check.png
.playwright-mcp/

# Python-кэш инспектора Figma (tools/figma)
__pycache__/
