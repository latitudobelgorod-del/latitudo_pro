# Логи и очереди интеграций. Через HTTP — НИКОГДА.
#
# Здесь лежат:
#   b24-lead.log        — лог создания лидов в Битрикс24;
#   metrika-conv.log    — лог очереди офлайн-конверсий Метрики;
#   metrika-queue.jsonl — сама очередь: yclid (идентификатор рекламного клика) и время
#                         заявки. Плюс *.batch — то же самое на время отправки в API.
#
# Папка /local/ — обычный веб-каталог: без этого файла Apache отдал бы содержимое
# по прямой ссылке вида /local/logs/metrika-queue.jsonl любому желающему. Корневой
# .htaccess тут не поможет — он не версионируется в git и на проде свой.
#
# Файл лежит рядом с данными намеренно: он уезжает на прод вместе с кодом обычным
# git pull, а значит защита не может «забыться» при развёртывании.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
